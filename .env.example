# GitHub Access (Fine-grained Personal Access Token with read-only Contents & Metadata)
GITHUB_TOKEN=ghp_example_pat_here

# LLM Configuration (provider: gemini or claude)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.5-flash

# LinkedIn OAuth & Posts API Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
LINKEDIN_VERSION=202601

# Telegram Approval Bot (Optional for CLI-only use)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Safety Controls (Must default to true)
DRY_RUN=true
